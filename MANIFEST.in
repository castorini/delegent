include LICENSE
include README.md
include REPRODUCING.md
include pyproject.toml
include uv.lock

recursive-include assets *.png
recursive-include configs *.json *.md
recursive-include docs *.md
recursive-include examples *.json *.jsonl
recursive-include results *.csv *.json *.md
recursive-include scripts *.py
recursive-include src/delegent *.py
recursive-include tests *.py

global-exclude .DS_Store
global-exclude *.py[cod]
global-exclude __pycache__
